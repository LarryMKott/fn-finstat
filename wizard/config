[
  {
    "stepTitle": "数据库设置",
    "items": [
      {
        "type": "select",
        "field": "wizard_db_type",
        "label": "数据库类型",
        "initValue": "sqlite",
        "options": [
          { "label": "SQLite（内置，无需配置）", "value": "sqlite" },
          { "label": "MySQL", "value": "mysql" },
          { "label": "PostgreSQL", "value": "postgresql" }
        ]
      },
      {
        "type": "tips",
        "helpText": "选择 MySQL / PostgreSQL 时请填写下方连接信息，并确保数据库已创建、账号具有读写权限；应用启动时会自动建表。"
      },
      { "type": "text", "field": "wizard_db_host", "label": "数据库地址", "initValue": "127.0.0.1" },
      { "type": "text", "field": "wizard_db_port", "label": "端口（留空按数据库类型取默认：MySQL 3306 / PostgreSQL 5432）" },
      { "type": "text", "field": "wizard_db_name", "label": "数据库名", "initValue": "fn_finstat" },
      { "type": "text", "field": "wizard_db_user", "label": "用户名", "initValue": "root" },
      { "type": "password", "field": "wizard_db_password", "label": "密码" }
    ]
  },
  {
    "stepTitle": "接口地址",
    "items": [
      {
        "type": "text",
        "field": "wizard_api_base_path",
        "label": "前后端接口地址前缀",
        "initValue": "/app/fn-finstat",
        "rules": [
          { "required": true, "message": "请填写接口地址前缀" },
          { "pattern": "^/", "message": "需以 / 开头的路径" }
        ]
      },
      {
        "type": "tips",
        "helpText": "前后端均通过该前缀访问（前端运行时自动适配，修改后无需重新构建）。使用统一网关时请保持与网关前缀 /app/fn-finstat 一致；独立部署或反代场景可自定义。注意：桌面图标入口固定为 /app/fn-finstat，不会随此处修改而变化，自定义前缀后请通过新地址访问。"
      }
    ]
  },
  {
    "stepTitle": "服务端口",
    "items": [
      {
        "type": "text",
        "field": "wizard_port",
        "label": "HTTP 服务端口",
        "initValue": "8090",
        "rules": [{ "pattern": "^[0-9]{1,5}$", "message": "请输入 1-65535 之间的数字端口" }]
      },
      {
        "type": "tips",
        "helpText": "通过飞牛 fnOS 统一网关访问（桌面图标入口，推荐）时，应用经系统内部 Unix Socket 通信，不占用 TCP 端口，本项保持默认即可。独立部署、反向代理或本地直接运行时，此端口为 HTTP 服务端口；被其它程序占用时可修改，重启应用后生效。"
      }
    ]
  }
]
