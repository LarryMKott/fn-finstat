# Python
__pycache__/
*.pyc
venv/
.venv/

# Node / 前端
node_modules/
frontend/dist/

# 前端构建产物（vite 输出至 app/static/assets，由构建生成，不入库）
# 说明：app/static/index.html 与 sw.js 是 vite 的输入模板，属源码，必须入库；
# 只有内容哈希命名的 assets/ 是产物。见 scripts/build_fpk.sh 的产物门禁。
app/static/assets/

# 本地运行数据（模拟生产 TRIM_PKGVAR / TRIM_PKGTMP）
.local_data/
.local_tmp/

# 本地工具状态
.workbuddy/
.mimosa/

# 本地开发环境变量（不打包进 FPK）
.env.dev

# 打包产物
*.fpk
dist/

# Release 日志：由 scripts/gen_release_notes.py 在 CI 中生成，不入库
# （CHANGELOG.md 是手工纳入版本管理的历史记录，不受此规则影响）
releaseNode.txt

# 运行日志
app.log
app.log.*

# IDE
.idea/
.vscode/
