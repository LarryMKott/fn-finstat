#!/bin/bash
# fn-finstat 生命周期脚本（fnOS 调用：start / stop / status）
# 依赖环境变量：TRIM_APPDEST / TRIM_PKGVAR / TRIM_PKGTMP / TRIM_TEMP_LOGFILE
# 规范依据：https://github.com/LarryMKott/fnnas-docs（framework.md / runtime.md / environment-variables.md）

# 引入 Python 运行时（manifest 已声明 install_dep_apps=python312）
export PATH=/var/apps/python312/target/bin:$PATH

# 平台注入的必备变量缺失时立即失败（异常安装/手工调试误运行），避免路径拼成
# /app.log、/finance 之类静默落到根目录
: "${TRIM_PKGVAR:?缺少 TRIM_PKGVAR 环境变量}"
: "${TRIM_APPDEST:?缺少 TRIM_APPDEST 环境变量}"
: "${TRIM_PKGTMP:?缺少 TRIM_PKGTMP 环境变量}"

LOG_FILE="${TRIM_PKGVAR}/app.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"
LOCK_FILE="${TRIM_PKGVAR}/.ctl.lock"
APP_ROOT="${TRIM_APPDEST}"              # 平台将 app.tgz 解压到该根目录（app/ 为 Python 包子目录）
VENV_DIR="${TRIM_PKGVAR}/venv"
PYTHON_BIN="${VENV_DIR}/bin/python"
SOCKET_FILE="${TRIM_APPDEST}/app.sock"  # 统一网关 Socket（见 gateway-registration.md）
export LOG_FILE                          # 应用内 RotatingFileHandler 据此路径写入并轮转

log_msg() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "$LOG_FILE"
}

# 规范要求：非零退出前把简短、可执行的用户可见错误写入 TRIM_TEMP_LOGFILE
fail() {
  local msg="$1"
  if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
    echo "$msg" > "$TRIM_TEMP_LOGFILE"
  else
    echo "$msg" >&2
  fi
  log_msg "FAILED: $msg"
  exit 1
}

check_process() {
  local pid="$1"
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null || return 1
  # 防 PID 被系统复用误判：校验命令行确为本应用的 uvicorn 进程（无 /proc 的环境退回存活检查）
  if [ -r "/proc/$pid/cmdline" ]; then
    tr '\0' ' ' < "/proc/$pid/cmdline" | grep -q "uvicorn.*app\.main:app"
  fi
}

status_app() {
  if [ -f "$PID_FILE" ]; then
    local pid
    pid="$(head -n 1 "$PID_FILE" | tr -d '[:space:]')"
    if check_process "$pid"; then
      return 0
    fi
    # 查询路径不做清理（读操作无副作用）：过期 PID 文件由 start/stop 路径处理，
    # 并发 status 与 stop 竞争时这里删文件会干扰对方的判断
  fi
  return 1
}

# 生命周期操作互斥：并发/快速连续的 start、stop 会互相覆盖 PID 文件，
# 产生杀不掉的孤儿进程。noclobber 原子建锁，后到者直接放弃（不排队）。
acquire_lock() {
  if ( set -o noclobber; echo "$$" > "$LOCK_FILE" ) 2>/dev/null; then
    trap 'rm -f "$LOCK_FILE"' EXIT
    return 0
  fi
  log_msg "另一个生命周期操作正在进行，跳过本次 $1"
  return 1
}

start_app() {
  if status_app; then
    log_msg "Already running."
    return 0
  fi
  log_msg "Starting fn-finstat..."
  mkdir -p "${TRIM_PKGVAR}/finance" "${TRIM_PKGTMP}/fn-finstat"
  if [ ! -x "$PYTHON_BIN" ]; then
    log_msg "venv missing, creating..."
    python3 -m venv "$VENV_DIR" || fail "创建 Python 虚拟环境失败"
    "$PYTHON_BIN" -m pip install --no-cache-dir -r "$APP_ROOT/requirements.txt" \
      || fail "Python 依赖安装失败，请检查设备网络后重试"
  fi
  cd "$APP_ROOT" || fail "应用目录不存在：$APP_ROOT"
  rm -f "$SOCKET_FILE"
  # 引导日志：应用内 RotatingFileHandler 要到 logging 初始化后才接管日志，
  # import 阶段的崩溃（依赖缺失/语法错误/配置异常）只有这里留得下痕迹
  BOOT_LOG="${TRIM_PKGVAR}/boot.err"
  nohup "$PYTHON_BIN" -m uvicorn app.main:app --uds "$SOCKET_FILE" \
    > "$BOOT_LOG" 2>&1 &
  echo "$!" > "$PID_FILE"
  log_msg "started pid=$(cat "$PID_FILE") socket=$SOCKET_FILE"
  # 就绪探活：uvicorn 启动即败时进程秒退，不能让平台误判为「运行中」
  local count=0
  while [ "$count" -lt 15 ]; do
    if [ -S "$SOCKET_FILE" ]; then
      log_msg "ready (waited ${count}s)"
      rm -f "$BOOT_LOG"
      return 0
    fi
    if ! check_process "$(cat "$PID_FILE" 2>/dev/null)"; then
      tail -n 20 "$BOOT_LOG" >> "$LOG_FILE" 2>/dev/null || true
      fail "应用进程启动后立即退出，请检查依赖与配置（引导日志已并入应用日志）"
    fi
    sleep 1
    count=$((count + 1))
  done
  tail -n 20 "$BOOT_LOG" >> "$LOG_FILE" 2>/dev/null || true
  fail "应用 15 秒内未就绪（unix socket 未出现），请检查应用日志"
}

stop_app() {
  log_msg "Stopping fn-finstat..."
  if [ ! -f "$PID_FILE" ]; then
    return 0
  fi
  local pid
  pid="$(head -n 1 "$PID_FILE" | tr -d '[:space:]')"
  if ! check_process "$pid"; then
    rm -f "$PID_FILE"
    return 0
  fi
  kill -TERM "$pid" 2>> "$LOG_FILE" || true
  local count=0
  while check_process "$pid" && [ "$count" -lt 10 ]; do
    sleep 1
    count=$((count + 1))
  done
  if check_process "$pid"; then
    kill -KILL "$pid" 2>> "$LOG_FILE" || true
  fi
  rm -f "$PID_FILE"
  rm -f "$SOCKET_FILE"
}

case "$1" in
  start)
    acquire_lock "$1" || exit 0
    start_app
    ;;
  stop)
    acquire_lock "$1" || exit 0
    stop_app
    ;;
  status)
    if status_app; then
      exit 0
    fi
    exit 3
    ;;
  *)
    echo "Unknown command: $1" > "${TRIM_TEMP_LOGFILE:-/dev/null}"
    exit 1
    ;;
esac
