#!/bin/bash
# fn-finstat 生命周期脚本（fnOS 调用：start / stop / status）
# 依赖环境变量：TRIM_APPDEST / TRIM_PKGVAR / TRIM_PKGTMP / TRIM_TEMP_LOGFILE
# 规范依据：https://github.com/LarryMKott/fnnas-docs（framework.md / runtime.md / environment-variables.md）

# 引入 Python 运行时（manifest 已声明 install_dep_apps=python312）
export PATH=/var/apps/python312/target/bin:$PATH

LOG_FILE="${TRIM_PKGVAR}/app.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"
APP_ROOT="${TRIM_APPDEST}"              # 平台将 app.tgz 解压到该根目录（app/ 为 Python 包子目录）
VENV_DIR="${TRIM_PKGVAR}/venv"
PYTHON_BIN="${VENV_DIR}/bin/python"
SOCKET_FILE="${TRIM_APPDEST}/app.sock"  # 统一网关 Socket（见 gateway-registration.md）

log_msg() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "$LOG_FILE"
}

# 规范要求：非零退出前把简短、可执行的用户可见错误写入 TRIM_TEMP_LOGFILE
fail() {
  local msg="$1"
  if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
    echo "$msg" > "$TRIM_TEMP_LOGFILE"
  else
    echo "$msg" >&2
  fi
  log_msg "FAILED: $msg"
  exit 1
}

# 简易日志轮转：超过 10MB 归档为 app.log.1
rotate_log() {
  if [ -f "$LOG_FILE" ] && [ "$(wc -c < "$LOG_FILE")" -gt 10485760 ]; then
    mv -f "$LOG_FILE" "$LOG_FILE.1"
  fi
}

check_process() {
  local pid="$1"
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

status_app() {
  if [ -f "$PID_FILE" ]; then
    local pid
    pid="$(head -n 1 "$PID_FILE" | tr -d '[:space:]')"
    if check_process "$pid"; then
      return 0
    fi
    rm -f "$PID_FILE"
  fi
  return 1
}

start_app() {
  if status_app; then
    log_msg "Already running."
    return 0
  fi
  rotate_log
  log_msg "Starting fn-finstat..."
  mkdir -p "${TRIM_PKGVAR}/finance" "${TRIM_PKGTMP}/fn-finstat"
  if [ ! -x "$PYTHON_BIN" ]; then
    log_msg "venv missing, creating..."
    python3 -m venv "$VENV_DIR" || fail "创建 Python 虚拟环境失败"
    "$PYTHON_BIN" -m pip install --no-cache-dir -r "$APP_ROOT/requirements.txt" \
      || fail "Python 依赖安装失败，请检查设备网络后重试"
  fi
  cd "$APP_ROOT" || fail "应用目录不存在：$APP_ROOT"
  rm -f "$SOCKET_FILE"
  nohup "$PYTHON_BIN" -m uvicorn app.main:app --uds "$SOCKET_FILE" >> "$LOG_FILE" 2>&1 &
  echo "$!" > "$PID_FILE"
  log_msg "started pid=$(cat "$PID_FILE") socket=$SOCKET_FILE"
}

stop_app() {
  log_msg "Stopping fn-finstat..."
  if [ ! -f "$PID_FILE" ]; then
    return 0
  fi
  local pid
  pid="$(head -n 1 "$PID_FILE" | tr -d '[:space:]')"
  if ! check_process "$pid"; then
    rm -f "$PID_FILE"
    return 0
  fi
  kill -TERM "$pid" 2>> "$LOG_FILE" || true
  local count=0
  while check_process "$pid" && [ "$count" -lt 10 ]; do
    sleep 1
    count=$((count + 1))
  done
  if check_process "$pid"; then
    kill -KILL "$pid" 2>> "$LOG_FILE" || true
  fi
  rm -f "$PID_FILE"
  rm -f "$SOCKET_FILE"
}

case "$1" in
  start)
    start_app
    ;;
  stop)
    stop_app
    ;;
  status)
    if status_app; then
      exit 0
    fi
    exit 3
    ;;
  *)
    echo "Unknown command: $1" > "$TRIM_TEMP_LOGFILE"
    exit 1
    ;;
esac
